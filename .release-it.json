{
  "git": {
    "commit": false,
    "tag": false,
    "push": false,
    "requireCleanWorkingDir": true
  },
  "github": {
    "release": false
  },
  "npm": {
    "publish": false
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": {
        "name": "conventionalcommits"
      },
      "infile": "CHANGELOG.md",
      "header": "# Changelog",
      "ignoreRecommendedBump": true,
      "context": {
        "host": "https://github.com",
        "owner": "appodeal",
        "repository": "appodeal-unity-plugin-upm",
        "repoUrl": "https://github.com/appodeal/appodeal-unity-plugin-upm"
      }
    }
  }
}
