root = true

# Global defaults
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

# C# defaults
[**/*.cs]
indent_style = space
indent_size = 4

# Braced case blocks stay at the case label level
csharp_indent_case_contents_when_block = false

# Disable "namespace doesn't match folder structure" for all C# files
dotnet_diagnostic.IDE0130.severity = none
resharper_check_namespace_highlighting = none

# Types that mirror an external contract keep its naming: JSON DTOs with
# snake_case fields and Android callback proxies with Java method names
[{**/Dtos/**/*.cs,**/Platforms/Android/Callbacks/*.cs}]
dotnet_diagnostic.IDE1006.severity = none
resharper_inconsistent_naming_highlighting = none
